    {
      "parameters": {
        "jsCode": "// How many days out counts as \"coming up soon\"\nconst REMINDER_WINDOW_DAYS = 15;\n\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0); // normalize to midnight for clean date math\n\nconst items = $input.all();\nconst dueForReminder = [];\n\nfor (const entry of items) {\n  const row = entry.json;\n\n  // Kit Confirmed can come back as boolean or string depending on the sheet cell type\n  const kitConfirmed = row['Kit Confirmed'] === true || row['Kit Confirmed'] === 'true';\n\n  if (kitConfirmed) continue; // already sorted, skip\n\n  // Start Date is stored as YYYY-MM-DD\n  const startDate = new Date(row['Start Date']);\n  startDate.setHours(0, 0, 0, 0);\n\n  if (isNaN(startDate.getTime())) continue; // skip unparseable dates\n\n  const daysUntilStart = Math.round((startDate - today) / (1000 * 60 * 60 * 24));\n\n  // Fires if start date is today, in the past (overdue!), or within the window\n  if (daysUntilStart <= REMINDER_WINDOW_DAYS) {\n    dueForReminder.push({\n      json: {\n        fullName: row['Full Name'],\n        company: row['Company Name'],\n        startDate: row['Start Date'],\n        email: row['Email'],\n        daysUntilStart,\n        rowNumber: row['row_number'] // handy if you later want to write back / mark as reminded\n      }\n    });\n  }\n}\n\nreturn dueForReminder;"
      },
