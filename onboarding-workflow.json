    {
      "parameters": {
        "jsCode": "// Grab the submitted form data\nconst item = $input.first().json;\n\n// --- Slugify company name into a domain ---\nconst companySlug = item['Company Name']\n  .toLowerCase()\n  .replace(/[^a-z0-9\\s]/g, '')   // strip punctuation\n  .replace(/\\s+/g, '');          // remove spaces\nconst domain = `${companySlug}.com`;\n\n// --- Build first.last username/email ---\nconst nameParts = item['Name'].trim().split(/\\s+/);\nconst firstName = nameParts[0];\nconst lastName = nameParts.length > 1 ? nameParts[nameParts.length - 1] : '';\n\nconst usernameBase = lastName\n  ? `${firstName}.${lastName}`\n  : firstName; // fallback if only one name given\n\nconst username = usernameBase.toLowerCase();\nconst email = `${username}@${domain}`;\n\n// --- Parse Start Date (DD/MM/YYYY -> real Date + ISO string) ---\nconst [day, month, year] = item['Start Date'].split('/').map(Number);\nconst startDate = new Date(year, month - 1, day);\nconst startDateISO = startDate.toISOString().split('T')[0]; // YYYY-MM-DD\n\n// --- Validation ---\nconst errors = [];\n\nif (!item['Name']) errors.push('Name is missing');\nif (!item['Company Name']) errors.push('Company name is missing');\nif (!item['Role']) errors.push('Role is missing');\nif (!item['Access Needed'] || item['Access Needed'].length === 0) {\n  errors.push('No access requested \u2014 at least one item expected');\n}\nif (isNaN(startDate.getTime())) {\n  errors.push('Start Date could not be parsed');\n}\n\nconst isValid = errors.length === 0;\n\n// --- Build clean output object ---\nreturn {\n  json: {\n    isValid,\n    errors,\n    fullName: item['Name'],\n    firstName,\n    lastName,\n    company: item['Company name'],\n    domain,\n    role: item['Role'],\n    startDate: startDateISO,\n    startDateRaw: item['Start Date'],\n    username,\n    email,\n    accessNeeded: item['Access Needed'],\n    kitConfirmed: false // placeholder for the reminder branch later\n  }\n};"
      },
